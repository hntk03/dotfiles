set main-view = date:default,local=yes author:full,width=10 id commit-title:graph=v2,refs=yes

set refresh-mode = auto
set diff-highlight = true

set vertical-split = no
set split-view-height = 80%

bind generic g move-first-line
bind generic G move-last-line

bind generic <Ctrl-f> move-page-down
bind generic <Ctrl-b> move-page-up

bind generic n find-next
bind generic N find-prev

bind diff h scroll-left
bind diff l scroll-right
bind stage h scroll-left
bind stage l scroll-right

bind main T ?git tag -a "%(prompt Enter tag name: )" %(commit)
bind main p ?git push origin %(branch)
bind refs d ?git branch -D %(branch)
bind refs s ?git switch %(branch)

# Color scheme inspired by tender
color default 255 235
color cursor default  238
color status default default
color title-focus 142 default
color title-blur 81 default
color search-result 160 default
color delimiter red default

color date 81 default
color author 185  default
color id 180 default
